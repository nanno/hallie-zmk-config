#undef ZMK_BEHAVIORS_KEEP_ALL

#define ZMK_BEHAVIORS_KEEP_IND
#define ZMK_BEHAVIORS_KEEP_BT
#define ZMK_BEHAVIORS_KEEP_GRESC
#define ZMK_BEHAVIORS_KEEP_SYS_RESET
#define ZMK_BEHAVIORS_KEEP_BOOTLOADER
#define ZMK_BEHAVIORS_KEEP_CAPS_WORD
#define ZMK_BEHAVIORS_KEEP_KEY_REPEAT
#define ZMK_BEHAVIORS_KEEP_KT
#define ZMK_BEHAVIORS_KEEP_LT
#define ZMK_BEHAVIORS_KEEP_MT
#define ZMK_BEHAVIORS_KEEP_SK
#define ZMK_BEHAVIORS_KEEP_STICKY_LAYER
#define ZMK_BEHAVIORS_KEEP_TO
#define ZMK_BEHAVIORS_KEEP_TOG
#define ZMK_BEHAVIORS_KEEP_TRANS
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10

#include <dt-bindings/zmk/indicators.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

/ {
    combos {
        compatible = "zmk,combos";

        enter {
            bindings = <&kp RETURN>;
            key-positions = <22 21>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <10 9>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
        };

        grv {
            bindings = <&kp GRAVE>;
            key-positions = <2 3>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <13 14>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <9 8>;
        };

        bkslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <16 19>;
        };

        f1 {
            bindings = <&kp F1>;
            key-positions = <1 16 39 39>;
        };

        f2 {
            bindings = <&kp F2>;
            key-positions = <2 16 39>;
        };

        f3 {
            bindings = <&kp F3>;
            key-positions = <16 3 39>;
        };

        f4 {
            bindings = <&kp F4>;
            key-positions = <4 16 39>;
        };

        f5 {
            bindings = <&kp F5>;
            key-positions = <16 5 39>;
        };

        f6 {
            bindings = <&kp F6>;
            key-positions = <16 6 39>;
        };

        f7 {
            bindings = <&kp F7>;
            key-positions = <16 7 39>;
        };

        f8 {
            bindings = <&kp F8>;
            key-positions = <16 8 39>;
        };

        f9 {
            bindings = <&kp F9>;
            key-positions = <16 9 39>;
        };

        f10 {
            bindings = <&kp F10>;
            key-positions = <16 10 39>;
        };

        f11 {
            bindings = <&kp F11>;
            key-positions = <1 39 17>;
        };

        f12 {
            bindings = <&kp F12>;
            key-positions = <2 39 17>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&none  &lt 4 Q         &kp W           &kp E             &kp R        &kp T          &kp Y        &kp U        &kp I              &kp O            &kp P              &none
&none  &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LCTRL F  &kp G          &kp H        &mt RCTRL J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &mt RIGHT_GUI SQT  &none
&none  &lt 2 Z         &kp X           &kp C             &kp V        &kp B          &kp N        &kp M        &kp COMMA          &kp DOT          &kp SLASH          &none
                                       &mo 3             &none        &lt 1 SPACE    &lt 1 SPACE  &none        &mo 2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &scroll_u_d>;
        };

        number_layer {
            bindings = <
&none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5    &kp NUMBER_6   &kp N7           &kp N8                 &kp N9                      &kp N0                       &none
&none  &trans        &trans        &trans        &trans        &trans    &kp SEMICOLON  &mt RCTRL MINUS  &mt RIGHT_SHIFT EQUAL  &mt RIGHT_ALT LEFT_BRACKET  &mt RIGHT_GUI RIGHT_BRACKET  &none
&none  &trans        &trans        &trans        &trans        &trans    &kp BACKSLASH  &trans           &trans                 &trans                      &trans                       &none
                                   &trans        &trans        &trans    &trans         &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_DN PG_UP &scroll_l_r>;
        };

        nav_layer {
            bindings = <
&none  &trans  &trans  &trans  &trans  &trans    &trans  &kp HOME  &kp UP    &kp END    &kp PG_UP      &none
&none  &trans  &trans  &trans  &trans  &trans    &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PAGE_DOWN  &none
&none  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans     &trans         &none
                       &trans  &trans  &trans    &trans  &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW &inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        adjust_layer {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_CLR    &none           &none        &none        &none  &none  &none  &none
&none  &sys_reset    &none         &none           &out OUT_BLE  &out OUT_USB    &none        &none        &none  &none  &none  &none
&none  &bootloader   &none         &studio_unlock  &ind IND_ON   &ind BAT_ST     &ind IND_ON  &ind BAT_ST  &none  &none  &none  &none
                                   &mo 3           &none         &none           &none        &none        &none
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW &inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        mouse_layer {
            bindings = <
&trans  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans      &trans  &mkp MB4        &mmv MOVE_UP    &mkp MB5         &msc SCRL_UP    &trans
&trans  &trans  &trans  &mkp MB2        &mkp MB1         &mkp MB3    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN  &trans
&trans  &trans  &trans  &trans          &trans           &trans      &trans  &trans          &trans          &trans           &trans          &trans
                        &trans          &trans           &trans      &trans  &trans          &trans
            >;
        };
    };
};
